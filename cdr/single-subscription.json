            "eventHubAuthRuleId": {
              "type": "string",
              "value": "[resourceId('Microsoft.EventHub/namespaces/authorizationRules', variables('namespaceName'), 'armo-cdr-diagnostics-send')]"
            },
            "collectorIdentityClientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', 'armo-cdr-collector'), '2023-01-31').clientId]"
