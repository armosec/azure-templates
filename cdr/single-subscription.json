  "outputs": {
    "resourceGroup": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "eventHubNamespace": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'armo-cdr-stack'), '2025-04-01').outputs.eventHubNamespaceFqdn.value]"
    },
    "eventHubName": {
      "type": "string",
      "value": "[parameters('eventHubName')]"
    },
    "collectorIdentityClientId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'armo-cdr-stack'), '2025-04-01').outputs.collectorIdentityClientId.value]"
    }
  }
}